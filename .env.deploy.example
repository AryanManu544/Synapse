# Copy into Render env group "synapse-backend" — never commit real secrets.

VITE_API_BASE_URL=https://your-api.onrender.com

# Supabase (DB_* recommended on Render)
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=
DB_NAME=postgres

# Upstash — all three must use rediss://
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379
CELERY_BROKER_URL=rediss://default:TOKEN@HOST.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:TOKEN@HOST.upstash.io:6379

ENVIRONMENT=production
DEBUG=false
LOG_FORMAT=json
CORS_ORIGINS=https://your-app.vercel.app

GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_B64=

# --- LLM: pick ONE provider ---
# Groq (free tier): https://console.groq.com/keys
LLM_DEFAULT_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
LLM_DEFAULT_MODEL=llama-3.3-70b-versatile

# OpenAI (alternative)
# LLM_DEFAULT_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_DEFAULT_MODEL=gpt-4o-mini

RUN_REVIEWS_INLINE=true
