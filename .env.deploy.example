# Copy values into Render (env group "synapse-backend") and Vercel.
# Do not commit real secrets.

# ------------------------------------------------------------------------------
# Vercel (Project → Settings → Environment Variables)
# Root directory: frontend
# ------------------------------------------------------------------------------
# Set before deploy; use your Render API URL after the web service is live.
VITE_API_BASE_URL=https://synapse-api.onrender.com

# ------------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string (URI)
# Use "Session pooler" or "Transaction pooler" (port 6543) for Render.
# Paste as-is; the backend converts postgresql:// → postgresql+asyncpg:// + SSL.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.bzqehfqjnctjoougwkwv:hPqTG1elSoLf0MRm@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# Upstash → Redis database → Details → redis-cli (TLS)
# Use the same URL for all three variables.
# ------------------------------------------------------------------------------
REDIS_URL=redis://default:gQAAAAAAAfHEAAIgcDI4OTQ0ZWMxMTMzOWY0NzdkOGViMGFlZDI2N2U4YjgxNw@unified-airedale-127428.upstash.io:6379
CELERY_BROKER_URL=redis://default:gQAAAAAAAfHEAAIgcDI4OTQ0ZWMxMTMzOWY0NzdkOGViMGFlZDI2N2U4YjgxNw@unified-airedale-127428.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:gQAAAAAAAfHEAAIgcDI4OTQ0ZWMxMTMzOWY0NzdkOGViMGFlZDI2N2U4YjgxNw@unified-airedale-127428.upstash.io:6379

# ------------------------------------------------------------------------------
# Render shared backend env (synapse-api + synapse-celery)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_FORMAT=json

# Comma-separated; include your Vercel production URL (no trailing slash).
CORS_ORIGINS=https://your-app.vercel.app

GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# PEM with literal \n newlines, or paste multiline in Render dashboard.
GITHUB_APP_PRIVATE_KEY=

OPENAI_API_KEY=
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# GitHub App → Webhook URL (after Render deploy)
# ------------------------------------------------------------------------------
# https://synapse-api.onrender.com/api/v1/webhooks/github
