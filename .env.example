# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# Backend API
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
# Leave empty in Docker (uses Vite proxy). Set for local dev without proxy.
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_DB=synapse
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5432/synapse

# ------------------------------------------------------------------------------
# Redis (background tasks / caching)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REVIEW_LOCK_PROCESSING_TTL_SECONDS=3600
REVIEW_LOCK_COMPLETED_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# GitHub Webhooks
# ------------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=whsec_your_github_webhook_secret_here
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Optional: inline PEM (use \n for newlines) instead of a key file
GITHUB_APP_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# LLM Providers
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_MAX_DIFF_CHARS=120000

# Production (Vercel + Render + Supabase + Upstash): see .env.deploy.example
