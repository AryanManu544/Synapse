# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# Backend API
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
# Leave empty in Docker (uses Vite proxy). Set for local dev without proxy.
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_DB=synapse
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5432/synapse

# ------------------------------------------------------------------------------
# Redis (background tasks / caching)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERYD_CONCURRENCY=2
REVIEW_LOCK_PROCESSING_TTL_SECONDS=3600
REVIEW_LOCK_COMPLETED_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# GitHub Webhooks
# ------------------------------------------------------------------------------
# Get this from your GitHub App settings page under Webhook secret.
GITHUB_WEBHOOK_SECRET=
# Get this from your GitHub App settings page under App ID.
GITHUB_APP_ID=
# Download this from your GitHub App settings page under Private keys, then set the local file path.
GITHUB_APP_PRIVATE_KEY_PATH=
# Download this from your GitHub App settings page under Private keys, then paste the PEM with \n for newlines.
GITHUB_APP_PRIVATE_KEY=
# Download this from your GitHub App settings page under Private keys, then base64-encode the .pem file (best for Render).
GITHUB_APP_PRIVATE_KEY_B64=

# ------------------------------------------------------------------------------
# LLM Providers
# ------------------------------------------------------------------------------
# Get this from the OpenAI dashboard API keys page.
OPENAI_API_KEY=
# Get this from the Anthropic Console API keys page.
ANTHROPIC_API_KEY=
# Groq (free tier): https://console.groq.com — OpenAI-compatible API
# Get this from the Groq Console API keys page.
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
LLM_DEFAULT_PROVIDER=openai
# openai: gpt-4o, gpt-4o-mini | groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, ...
LLM_DEFAULT_MODEL=gpt-4o
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_MAX_DIFF_CHARS=120000

# Production (Vercel + Render + Supabase + Upstash): see .env.deploy.example
